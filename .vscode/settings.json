{
    "cmake.ignoreCMakeListsMissing": true,
    "lldb.launch.initCommands": [
        "command script import ${workspaceFolder}/.vscode/lldb_init.py"
    ],
    "lldb.launch.postRunCommands": [
        "command script import ${workspaceFolder}/.vscode/lldb_init.py"
    ],
    "rust-analyzer.linkedProjects": [
        "${workspaceFolder}/Cargo.toml",
        "${workspaceFolder}/python/Cargo.toml"
    ],
    "rust-analyzer.check.extraEnv": {
        "RUSTFLAGS": "-D warnings"
    },
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.defaultInterpreterPath": "${workspaceFolder}/python/.venv/bin/python",
    "python.envFile": "${workspaceFolder}/python/.env",
    "python.testing.pytestArgs": [
        "python/tests"
    ]
}