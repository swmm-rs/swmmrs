{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@swmmrs/swmmrs",
  "entryPoints": ["simulation.ts", "options.ts", "node.ts", "link.ts", "subcatchment.ts", "rain-gage.ts", "collections.ts", "definitions.ts", "rdii.ts", "lid.ts", "snapshots.ts", "output.ts", "types.ts", "exceptions.ts"],
  "tsconfig": "tsconfig.json",
  "plugin": ["typedoc-plugin-markdown", "./theme.mjs"],
  "theme": "swmmrs-reference",
  "out": ".generated",
  "json": ".generated/reflection.json",
  "router": "module",
  "entryFileName": "index",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "disableSources": true,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "hidePageTitle": true,
  "hideGroupHeadings": true,
  "useCodeBlocks": true,
  "useHTMLEncodedBrackets": true,
  "useCustomAnchors": true,
  "expandParameters": true,
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "sort": ["source-order"],
  "treatWarningsAsErrors": true,
  "validation": {
    "invalidLink": true,
    "notExported": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": ["Class", "Interface", "TypeAlias", "Function", "Method", "Property", "Accessor", "Constructor"]
}
