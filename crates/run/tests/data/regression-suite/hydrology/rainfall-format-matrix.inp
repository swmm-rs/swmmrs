[TITLE]
Provenance: purpose-built for swmm-bench.
NWS comma, NWS tape, and Canadian CMC hourly rainfall formats driving runoff.

[OPTIONS]
WET_STEP             00:05:00
LINK_OFFSETS         DEPTH
ROUTING_STEP         00:00:30
FLOW_UNITS           CFS
DRY_STEP             00:15:00
START_TIME           00:00:00
DRY_DAYS             0
REPORT_START_TIME    00:00:00
START_DATE           01/01/2020
INFILTRATION         HORTON
REPORT_START_DATE    01/01/2020
FLOW_ROUTING         KINWAVE
END_DATE             01/02/2020
END_TIME             00:00:00
REPORT_STEP          00:30:00

[EVAPORATION]
CONSTANT             0
DRY_ONLY             NO

[RAINGAGES]
;;Name    Format  Interval  SCF  Source
RG_COMMA  VOLUME  1:00      1.0  FILE "rain-nws-comma.dat" NWS_COMMA IN
RG_CMC    VOLUME  1:00      1.0  FILE "rain-cmc-hourly.dat" CMC_HOURLY MM
RG_TAPE   VOLUME  1:00      1.0  FILE "rain-nws-tape.dat" NWS_TAPE IN

[SUBCATCHMENTS]
;;Name   Rain Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S_COMMA  RG_COMMA   J1      1     80       200    1       0
S_CMC    RG_CMC     J1      1     80       200    1       0
S_TAPE   RG_TAPE    J1      1     80       200    1       0

[SUBAREAS]
;;Subcatchment  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S_CMC           0.01      0.10    0.02      0.05    25       OUTLET
S_COMMA         0.01      0.10    0.02      0.05    25       OUTLET
S_TAPE          0.01      0.10    0.02      0.05    25       OUTLET

[INFILTRATION]
;;Subcatchment  MaxRate  MinRate  Decay  DryTime  MaxInfil
S_COMMA         1.0      0.2      4.0    7.0      0
S_TAPE          1.0      0.2      4.0    7.0      0
S_CMC           1.0      0.2      4.0    7.0      0

[JUNCTIONS]
;;Name  Elevation  MaxDepth  InitDepth  SurDepth  Aponded
J1      1          5         0          0         0

[OUTFALLS]
;;Name  Elevation  Type  Stage Data  Gated
OUT     0          FREE              NO

[CONDUITS]
;;Name  From Node  To Node  Length  Roughness  InOffset  OutOffset  InitFlow  MaxFlow
C1      J1         OUT      100     0.013      0         0          0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  1      0      0      0      1

[REPORT]
INPUT          YES
CONTINUITY     YES
FLOWSTATS      YES
CONTROLS       NO
SUBCATCHMENTS  ALL
NODES          ALL
LINKS          ALL
