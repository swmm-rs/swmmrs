[TITLE]
Provenance: purpose-built for swmm-bench.
Modified Horton infiltration under a sustained storm with infiltration and runoff.

[OPTIONS]
START_DATE           01/01/2020
FLOW_UNITS           CFS
ROUTING_STEP         00:00:30
REPORT_STEP          00:15:00
FLOW_ROUTING         KINWAVE
START_TIME           00:00:00
WET_STEP             00:05:00
REPORT_START_TIME    00:00:00
INFILTRATION         MODIFIED_HORTON
LINK_OFFSETS         DEPTH
END_DATE             01/01/2020
END_TIME             12:00:00
REPORT_START_DATE    01/01/2020
DRY_STEP             00:15:00
DRY_DAYS             0

[EVAPORATION]
DRY_ONLY             NO
CONSTANT             0

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
Gage    INTENSITY  1:00      1.0  TIMESERIES Rain

[SUBCATCHMENTS]
;;Name  Rain Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      Gage       J1      1     0        200    1       0

[SUBAREAS]
;;Subcatchment  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1              0.01      0.10    0.02       0.05    0        OUTLET

[INFILTRATION]
;;Subcatchment  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1              1.0      0.2      4.0    7.0      0

[JUNCTIONS]
;;Name  Elevation  MaxDepth  InitDepth  SurDepth  Aponded
J1      1          5         0          0         0

[OUTFALLS]
;;Name  Elevation  Type  Stage Data  Gated
OUT     0          FREE              NO

[CONDUITS]
;;Name  From Node  To Node  Length  Roughness  InOffset  OutOffset  InitFlow  MaxFlow
C1      J1         OUT      100     0.013      0         0          0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  1      0      0      0      1

[TIMESERIES]
;;Name  Date        Time   Value
Rain    01/01/2020  00:00  2.0
Rain                01:00  2.0
Rain                02:00  2.0
Rain                03:00  2.0
Rain                04:00  2.0
Rain                05:00  2.0
Rain                06:00  2.0
Rain                07:00  2.0
Rain                08:00  0
Rain                12:00  0

[REPORT]
INPUT          YES
CONTINUITY     YES
FLOWSTATS      YES
CONTROLS       NO
SUBCATCHMENTS  ALL
NODES          ALL
LINKS          ALL
