[TITLE]
Provenance: purpose-built for swmm-bench.
Purpose-built hotstart interface consumer

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/08/1975
START_TIME           00:00:00
REPORT_START_DATE    01/08/1975
REPORT_START_TIME    00:00:00
END_DATE             01/09/1975
END_TIME             00:00:00
REPORT_STEP          00:05:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         00:00:05
THREADS              1

[FILES]
USE HOTSTART "hotstart-interface.bin"

[JUNCTIONS]
;;Name  Elevation  MaxDepth  InitDepth  SurDepth  Aponded
J1      0          5         0          0         0

[STORAGE]
;;Name  Elevation  MaxDepth  InitDepth  Shape       Curve/Params      Fevap
TANK    -1         10        0          FUNCTIONAL  500  0  0         0

[OUTFALLS]
;;Name  Elevation  Type  Stage Data  Gated
OUT     -2         FREE              NO

[CONDUITS]
;;Name  From Node  To Node  Length  Roughness  InOffset  OutOffset  InitFlow  MaxFlow
C1      J1         TANK     100     0.013      0         0          0         0

[OUTLETS]
;;Name  From Node  To Node  Offset  Type              QTable/Qcoeff  Qexpon  Gated
DRAIN   TANK       OUT      0       FUNCTIONAL/DEPTH  0.02           0.5     NO

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  1      0      0      0      1

[INFLOWS]
;;Node  Constituent  Time Series  Type  Mfactor  Sfactor  Baseline  Pattern
J1      FLOW         INFLOW       FLOW  1.0      1.0      0.0

[TIMESERIES]
;;Name  Date        Time   Value
INFLOW  01/07/1975  00:00  0.00
INFLOW  01/07/1975  20:00  0.00
INFLOW  01/07/1975  20:05  0.05
INFLOW  01/07/1975  23:55  0.05
INFLOW  01/08/1975  00:00  0.00
INFLOW  01/08/1975  01:00  0.03
INFLOW  01/08/1975  02:00  0.03
INFLOW  01/08/1975  02:05  0.00
INFLOW  01/09/1975  00:00  0.00

[REPORT]
INPUT              NO
CONTROLS           NO
SUBCATCHMENTS      NONE
NODES              ALL
LINKS              ALL
