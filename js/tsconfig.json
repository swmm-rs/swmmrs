{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "rootDir": "src/swmmrs",
    "outDir": "lib/swmmrs",
    "verbatimModuleSyntax": true
  },
  "include": ["src/swmmrs/**/*.ts"]
}
