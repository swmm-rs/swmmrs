[TITLE]
Generation-safe collection coverage model.

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
LINK_OFFSETS         DEPTH
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             02:00:00
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         00:00:30

[RAINGAGES]
Gage-A INTENSITY 0:05 1.0 TIMESERIES RainSeries

[SUBCATCHMENTS]
Sub-A Gage-A J1 1.0 25 100 1.0 0

[SUBAREAS]
Sub-A 0.01 0.1 0.05 0.05 25 OUTLET

[INFILTRATION]
Sub-A 3.0 0.5 4.0 7.0 0

[JUNCTIONS]
J1 10 5 0 0 0
123 9 5 0 0 0

[DIVIDERS]
Divider-A 10 Divider-Div CUTOFF 2.0 5 0 0 0

[STORAGE]
Storage-A 8 5 0 FUNCTIONAL 100 0 0 0 0

[OUTFALLS]
Main-Out 0 FREE NO
Div-Out 0 FREE NO
J-Out 0 FREE NO
Storage-Out 0 FREE NO
Pump-Out 0 FREE NO
Orifice-Out 0 FREE NO
Weir-Out 0 FREE NO
Outlet-Out 0 FREE NO

[CONDUITS]
Divider-Main Divider-A Main-Out 100 0.013 0 0 0 0
Divider-Div Divider-A Div-Out 100 0.013 0 0 0 0
J-Pipe J1 J-Out 100 0.013 0 0 0 0
Storage-Pipe Storage-A Storage-Out 100 0.013 0 0 0 0

[PUMPS]
Pump-A 123 Pump-Out PumpCurve ON 0 0

[ORIFICES]
Orifice-A 123 Orifice-Out SIDE 0 0.65 NO

[WEIRS]
Weir-A 123 Weir-Out TRANSVERSE 0 3.3 NO 0 0 NO

[OUTLETS]
Outlet-A 123 Outlet-Out 0 FUNCTIONAL/DEPTH 1.0 1.0 NO

[XSECTIONS]
Divider-Main CIRCULAR 2 0 0 0 1
Divider-Div CIRCULAR 2 0 0 0 1
Orifice-A CIRCULAR 2 0 0 0 1
Weir-A RECT_OPEN 2 2 0 0 1
J-Pipe CIRCULAR 2 0 0 0 1
Storage-Pipe CIRCULAR 2 0 0 0 1

[POLLUTANTS]
TSS MG/L 0 0 0 0 NO * 0 0 0

[LANDUSES]
Land-A 0 0 0

[PATTERNS]
Pattern-A MONTHLY 1 1 1 1 1 1
Pattern-A 1 1 1 1 1 1

[CURVES]
PumpCurve PUMP4 0 0
PumpCurve 5 2
Shape-A SHAPE 0 0
Shape-A 1 1

[TIMESERIES]
RainSeries 00:00 0
RainSeries 00:05 0.1
RainSeries 02:00 0

[CONTROLS]
RULE Control-A
IF NODE J1 DEPTH > 1
THEN PUMP Pump-A STATUS = OFF

[TRANSECTS]
NC 0.01 0.01 0.01
X1 Transect-A 3 0 0 0 0 0 0 0
GR 1 1 0 2 1 3

[AQUIFERS]
Aquifer-A 0.48 0.25 0.37 5 10 15 0.35 14 0.002 0 10 0.3

[HYDROGRAPHS]
Hydrograph-A Gage-A
Hydrograph-A ALL SHORT 0.01 1 2 0 0 0

[SNOWPACKS]
Snow-A PLOWABLE 0.003 0.01 31 0.03 0.1 0 0
Snow-A IMPERVIOUS 0.003 0.01 32 0.05 0.1 0 1
Snow-A PERVIOUS 0.003 0.01 32 0.05 0.2 0 1

[LID_CONTROLS]
Lid-A VS
Lid-A SURFACE 1 0.1 0.1 1 5

[STREETS]
Street-A 20 0.5 0.02 0.016 0 0 1 0 0 0

[INLETS]
Inlet-A SLOTTED 4.0 0.5

[REPORT]
INPUT NO
CONTROLS NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL
